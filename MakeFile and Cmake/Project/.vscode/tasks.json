{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                //"-fdiagnostics-color=always",
                "-g",
                "-Iinclude",
                "./src/*.cpp",
                "-o",
                "${workspaceFolder}/main",
            ],
            // "command": "g++ -g -Iinclude ${workspaceFolder}/src/*.cpp -o ${workspaceFolder}/main",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger.",
            "dependsOn": "Run Main"
        },
        {
            "label": "Run Main",
            "type": "shell",
            "command": "gnome-terminal",
            "args": [
                "--title=Debugging main",
                "--",
                "bash",
                "-c",
                "./main; echo ''; read -p \"Press Enter to close...\" var"
            ],
        }
    ],
    "version": "2.0.0"
}