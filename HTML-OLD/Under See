//Counter-Controlled repetition 
Used when number of iterations is known.
for (int i = 0; i < 10; i++) {
    printf("%d\n", i);
}
//Sentinel-Controlled repetition 
Used when number of iterations is unknown — loop until a special sentinel value appears.
int x;
printf("Enter numbers (-1 to exit): ");
scanf("%d", &x);

while (x != -1) {
    // process
    scanf("%d", &x);
}

